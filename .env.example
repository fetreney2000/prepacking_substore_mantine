# Copy to .env for local development.
# On Vercel these must be set in Project Settings > Environment Variables.

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Shared password prompted at /login (required).
# The app fails closed: login is refused while this is empty.
AUTH_PASSWORD=

# Signs the session cookie (required). Generate with: openssl rand -hex 32
# Rotating this value invalidates every active session.
AUTH_SECRET=
